# /etc/systemd/system/ukbangla-web.service
[Unit]
Description=UK Bangla Guardian web (Next.js)
After=network.target

[Service]
User=deploy
Group=www-data
WorkingDirectory=/srv/ukbangla/frontend
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_API_URL=https://ukbanglaguardian.com
ExecStart=/srv/ukbangla/frontend/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
